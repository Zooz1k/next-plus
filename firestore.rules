rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if admin() || (signedIn() && request.auth.uid == uid);
      allow delete: if admin();
    }

    match /services/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if admin();
      allow delete: if admin();
    }

    match /notifications/{id} {
      allow create: if admin();
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}